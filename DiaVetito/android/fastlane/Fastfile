default_platform(:android)

platform :android do
  desc "Build and deploy to the Play Store production track"
  lane :deploy do
    # The Gradle wrapper (gradlew) is gitignored, so it is absent from CI
    # checkouts. `flutter build` generates it automatically, so we must not
    # invoke the `gradle` action before the wrapper exists. `flutter clean`
    # provides the equivalent clean build instead.
    sh("flutter", "clean")
    sh("flutter", "pub", "get")
    sh("flutter", "build", "appbundle", "--release")
    upload_to_play_store(
      track: 'production',
      aab: '../build/app/outputs/bundle/release/app-release.aab',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build and deploy to the Play Store beta track"
  lane :beta do
    sh("flutter", "clean")
    sh("flutter", "pub", "get")
    sh("flutter", "build", "appbundle", "--release")
    upload_to_play_store(
      track: 'beta',
      aab: '../build/app/outputs/bundle/release/app-release.aab',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end