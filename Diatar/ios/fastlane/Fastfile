default_platform(:ios)

platform :ios do
  def signing_identity
    @signing_identity ||= begin
      output = `security find-identity -v -p codesigning 2>/dev/null`
      match = output.match(/"([^"]*iPhone[^"]*)"/)
      UI.user_error!("No iPhone signing identity found in keychain") unless match
      match[1]
    end
  end

  desc "Deploy to the App Store"
  lane :deploy do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_ISSUER_ID"],
      key_filepath: ENV["APPLE_API_KEY_FILEPATH"]
    )
    match(
      type: "appstore",
      readonly: true,
      team_id: ENV["APPLE_TEAM_ID"],
      api_key: api_key,
      verbose: true
    )

    sh("unzip", "-o", Dir.glob("*-ios-nosign.zip").first, "-d", "build/ios/iphoneos")
    sh("mkdir", "-p", "Payload")
    sh("cp", "-r", "build/ios/iphoneos/Runner.app", "Payload/")
    sh("zip", "-r", "unsigned.ipa", "Payload")

    resign(
      ipa: "unsigned.ipa",
      signing_identity: signing_identity,
      provisioning_profile: ENV["MATCH_PROVISIONING_PROFILE_NAME"] || "match AppStore eu.diatar.diatar"
    )

    upload_to_app_store(
      api_key: api_key,
      ipa: "unsigned.ipa",
      skip_screenshots: true,
      skip_metadata: false,
      metadata_path: "../../release-notes/Diatar",
      submission_information: { export_compliance_uses_encryption: false },
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Deploy to TestFlight (beta)"
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_ISSUER_ID"],
      key_filepath: ENV["APPLE_API_KEY_FILEPATH"]
    )
    match(
      type: "appstore",
      readonly: true,
      team_id: ENV["APPLE_TEAM_ID"],
      api_key: api_key,
      verbose: true
    )

    sh("unzip", "-o", Dir.glob("*-ios-nosign.zip").first, "-d", "build/ios/iphoneos")
    sh("mkdir", "-p", "Payload")
    sh("cp", "-r", "build/ios/iphoneos/Runner.app", "Payload/")
    sh("zip", "-r", "unsigned.ipa", "Payload")

    resign(
      ipa: "unsigned.ipa",
      signing_identity: signing_identity,
      provisioning_profile: ENV["MATCH_PROVISIONING_PROFILE_NAME"] || "match AppStore eu.diatar.diatar"
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "unsigned.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
