default_platform(:ios)

platform :ios do
  def signing_identity
    @signing_identity ||= begin
      output = `security find-identity -v -p codesigning`
      match = output.match(/"([^"]*Apple Distribution[^"]*)"/)
      UI.user_error!("No Apple Distribution signing identity found in keychain") unless match
      match[1]
    end
  end

  desc "Deploy to the App Store"
  lane :deploy do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_ISSUER_ID"],
      key_filepath: ENV["APPLE_API_KEY_FILEPATH"]
    )
    match(
      type: "appstore",
      readonly: true,
      team_id: ENV["APPLE_TEAM_ID"],
      api_key: api_key,
      verbose: true
    )

    ios_dir = File.expand_path("..", __dir__)
    build_dir = File.join(ios_dir, "build", "ios", "iphoneos")
    payload_dir = File.join(ios_dir, "Payload")
    zip_name = Dir.glob("*-ios-nosign.zip", base: ios_dir).first
    UI.user_error!("No *-ios-nosign.zip artifact found in #{ios_dir}") unless zip_name
    zip = File.join(ios_dir, zip_name)
    sh("mkdir", "-p", build_dir)
    sh("unzip", "-o", zip, "-d", build_dir)
    sh("mkdir", "-p", payload_dir)
    sh("cp", "-r", File.join(build_dir, "Runner.app"), payload_dir + "/")
    sh("zip", "-r", File.join(ios_dir, "unsigned.ipa"), payload_dir)

    resign(
      ipa: File.join(ios_dir, "unsigned.ipa"),
      signing_identity: signing_identity
    )

    upload_to_app_store(
      api_key: api_key,
      ipa: File.join(ios_dir, "unsigned.ipa"),
      skip_screenshots: true,
      skip_metadata: false,
      metadata_path: File.join(ios_dir, "..", "..", "release-notes", "Diatar"),
      submission_information: { export_compliance_uses_encryption: false },
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Deploy to TestFlight (beta)"
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_ISSUER_ID"],
      key_filepath: ENV["APPLE_API_KEY_FILEPATH"]
    )
    match(
      type: "appstore",
      readonly: true,
      team_id: ENV["APPLE_TEAM_ID"],
      api_key: api_key,
      verbose: true
    )

    ios_dir = File.expand_path("..", __dir__)
    build_dir = File.join(ios_dir, "build", "ios", "iphoneos")
    payload_dir = File.join(ios_dir, "Payload")
    zip_name = Dir.glob("*-ios-nosign.zip", base: ios_dir).first
    UI.user_error!("No *-ios-nosign.zip artifact found in #{ios_dir}") unless zip_name
    zip = File.join(ios_dir, zip_name)
    sh("mkdir", "-p", build_dir)
    sh("unzip", "-o", zip, "-d", build_dir)
    sh("mkdir", "-p", payload_dir)
    sh("cp", "-r", File.join(build_dir, "Runner.app"), payload_dir + "/")
    sh("zip", "-r", File.join(ios_dir, "unsigned.ipa"), payload_dir)

    resign(
      ipa: File.join(ios_dir, "unsigned.ipa"),
      signing_identity: signing_identity
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(ios_dir, "unsigned.ipa"),
      skip_waiting_for_build_processing: true
    )
  end
end
